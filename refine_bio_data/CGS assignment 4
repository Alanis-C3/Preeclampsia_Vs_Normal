if (!requireNamespace("glmnet", quietly = TRUE)) install.packages("glmnet")
if (!requireNamespace("pROC", quietly = TRUE))   install.packages("pROC")
if (!requireNamespace("matrixStats", quietly = TRUE)) install.packages("matrixStats")
if (!requireNamespace("dplyr", quietly = TRUE))  install.packages("dplyr")
if (!requireNamespace("tibble", quietly = TRUE)) install.packages("tibble")
library(glmnet); library(pROC); library(matrixStats); library(dplyr); library(tibble)

stopifnot(exists("expr_mat"), exists("pheno"), exists("gene_lookup"), exists("expr_top"))

# helper: top-n most variable genes
top_var <- function(expr, n) {
  rv <- matrixStats::rowVars(expr, na.rm = TRUE)
  ok <- is.finite(rv) & rv > 0
  expr_ok <- expr[ok, , drop = FALSE]
  rv_ok <- rv[ok]
  idx <- order(rv_ok, decreasing = TRUE)[seq_len(min(n, nrow(expr_ok)))]
  expr_ok[idx, , drop = FALSE]
}

# build Cluster labels if not present (k=2 on normalized 5000 genes)
if (!exists("out_cluster")) {
  X5000 <- t(expr_top)
  X5000 <- scale(X5000)
  set.seed(123)
  km <- kmeans(X5000, centers = 2, nstart = 25)
  clusters <- tibble(sample = rownames(X5000), cluster = as.character(km$cluster)) %>%
    dplyr::left_join(pheno, by = "sample")

  # map PE-like cluster by majority Group
  cluster_map <- clusters %>%
    dplyr::group_by(cluster) %>%
    dplyr::summarise(n = dplyr::n(),
                     major_group = names(sort(table(Group), decreasing = TRUE))[1],
                     .groups = "drop")
  if (any(cluster_map$major_group == "Preeclampsia")) {
    idx <- which(cluster_map$major_group == "Preeclampsia")
    pe_like_cluster <- cluster_map$cluster[idx][which.max(cluster_map$n[idx])]
  } else {
    pe_like_cluster <- cluster_map$cluster[which.max(cluster_map$n)]
  }
  out_cluster <- clusters %>%
    dplyr::mutate(cluster_bin = factor(ifelse(cluster == pe_like_cluster, "PE_like", "Other"),
                                       levels = c("Other", "PE_like"))) %>%
    dplyr::select(sample, cluster_bin)
}

# outcome data frames
pheno2 <- pheno %>% dplyr::mutate(Group = factor(Group, levels = c("Control", "Preeclampsia"))) %>%
  dplyr::select(sample, Group)

# core AUC function using cv.glmnet
run_cv_glmnet_auc <- function(expr_n, outcome_df, outcome_col, positive_label, seed = 2028) {
  X <- t(expr_n)
  # gene symbols as colnames
  colnames(X) <- make.unique(unname(gene_lookup[rownames(expr_n)]))
  df <- as.data.frame(X) %>% tibble::rownames_to_column("sample") %>%
    dplyr::left_join(outcome_df, by = "sample") %>%
    dplyr::filter(!is.na(.data[[outcome_col]]))

  # split 80/20 manually (to avoid rsample dependency)
  set.seed(seed)
  n <- nrow(df)
  idx <- sample(seq_len(n), size = floor(0.8 * n))
  train <- df[idx, ]
  test  <- df[-idx, ]

  # standardize using training stats
  Xtr <- as.matrix(train[, !(names(train) %in% c("sample", outcome_col))])
  mu  <- colMeans(Xtr)
  sdv <- apply(Xtr, 2, sd)
  sdv[sdv == 0] <- 1
  Xtr <- scale(Xtr, center = mu, scale = sdv)

  Xte <- as.matrix(test[, !(names(test) %in% c("sample", outcome_col))])
  Xte <- scale(Xte, center = mu, scale = sdv)

  # binomial response (negative first, positive second)
  ytr_fac <- factor(train[[outcome_col]], levels = c(setdiff(levels(train[[outcome_col]]), positive_label)[1], positive_label))
  ytr <- as.integer(ytr_fac == positive_label)

  cv <- glmnet::cv.glmnet(x = Xtr, y = ytr, family = "binomial", alpha = 1, nfolds = 5)
  fit <- glmnet::glmnet(x = Xtr, y = ytr, family = "binomial", lambda = cv$lambda.min, alpha = 1)

  # test probs and AUC
  probs <- as.numeric(predict(fit, newx = Xte, type = "response"))
  yte_fac <- factor(test[[outcome_col]], levels = c(setdiff(levels(train[[outcome_col]]), positive_label)[1], positive_label))
  yte <- as.integer(yte_fac == positive_label)
  as.numeric(pROC::auc(yte, probs))
}

# sweep gene counts
gene_counts <- c(10, 100, 1000, 10000)

group_auc <- sapply(gene_counts, function(n) {
  expr_n <- top_var(expr_mat, n)
  run_cv_glmnet_auc(expr_n, pheno2, outcome_col = "Group",       positive_label = "Preeclampsia")
})
cluster_auc <- sapply(gene_counts, function(n) {
  expr_n <- top_var(expr_mat, n)
  run_cv_glmnet_auc(expr_n, out_cluster, outcome_col = "cluster_bin", positive_label = "PE_like")
})

group_auc_df   <- tibble(genes = gene_counts, auc = as.numeric(group_auc))
cluster_auc_df <- tibble(genes = gene_counts, auc = as.numeric(cluster_auc))
print(group_auc_df)
print(cluster_auc_df)
