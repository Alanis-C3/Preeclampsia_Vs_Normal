# Load required tidymodels components explicitly
if (!requireNamespace("parsnip", quietly = TRUE))   install.packages("parsnip")
if (!requireNamespace("workflows", quietly = TRUE)) install.packages("workflows")
if (!requireNamespace("tune", quietly = TRUE))      install.packages("tune")
if (!requireNamespace("rsample", quietly = TRUE))   install.packages("rsample")
if (!requireNamespace("recipes", quietly = TRUE))   install.packages("recipes")
if (!requireNamespace("yardstick", quietly = TRUE)) install.packages("yardstick")
if (!requireNamespace("dials", quietly = TRUE))     install.packages("dials")
if (!requireNamespace("glmnet", quietly = TRUE))    install.packages("glmnet")
library(parsnip); library(workflows); library(tune); library(rsample)
library(recipes); library(yardstick); library(dials); library(glmnet); library(dplyr)

# Ensure factor order (Control negative, Preeclampsia positive)
train_df$Group <- factor(train_df$Group, levels = c("Control", "Preeclampsia"))
test_df$Group  <- factor(test_df$Group,  levels = c("Control", "Preeclampsia"))

# Recipe
rec <- recipes::recipe(Group ~ ., data = train_df)
rec <- recipes::update_role(rec, sample, new_role = "id")
rec <- recipes::step_zv(rec, recipes::all_predictors())
rec <- recipes::step_normalize(rec, recipes::all_predictors())

# Lasso logistic spec (no pipes)
log_spec <- parsnip::logistic_reg(penalty = tune::tune(), mixture = 1)
log_spec <- parsnip::set_engine(log_spec, "glmnet")
log_spec <- parsnip::set_mode(log_spec, "classification")

# Workflow
wf <- workflows::workflow()
wf <- workflows::add_recipe(wf, rec)
wf <- workflows::add_model(wf, log_spec)

# Folds and grid (keep metrics simple: ROC AUC only for tuning)
if (!exists("folds")) {
  folds <- rsample::vfold_cv(train_df, v = 5, repeats = 2, strata = Group)
}
grid <- dials::grid_regular(dials::penalty(), levels = 20)
metrics <- yardstick::metric_set(yardstick::roc_auc)

# Tune
set.seed(2025)
tune_res <- tune::tune_grid(
  wf,
  resamples = folds,
  grid      = grid,
  metrics   = metrics,
  control   = tune::control_grid(save_pred = TRUE)
)

# Pick best by ROC AUC (named argument)
best <- tune::select_best(tune_res, metric = "roc_auc")

# Manually finalize with best penalty
final_spec <- parsnip::logistic_reg(penalty = best$penalty, mixture = 1)
final_spec <- parsnip::set_engine(final_spec, "glmnet")
final_spec <- parsnip::set_mode(final_spec, "classification")

final_wf <- workflows::workflow()
final_wf <- workflows::add_recipe(final_wf, rec)
final_wf <- workflows::add_model(final_wf, final_spec)

# Fit finalized model
final_fit <- parsnip::fit(final_wf, data = train_df)

# Test-set predictions
test_probs <- predict(final_fit, test_df, type = "prob")
test_class <- predict(final_fit, test_df, type = "class")
test_results <- dplyr::bind_cols(
  dplyr::select(test_df, sample, Group),
  test_class,
  test_probs
)

# Compute metrics (set positive class as 'second'; use a generic prob column)
test_results$.pred_pos <- test_results[[".pred_Preeclampsia"]]
test_metrics <- dplyr::bind_rows(
  yardstick::accuracy(test_results, truth = Group, estimate = .pred_class),
  tryCatch(
    yardstick::roc_auc(test_results, truth = Group, .pred_pos, event_level = "second"),
    error = function(e) yardstick::roc_auc(test_results, truth = Group, estimate = .pred_pos, event_level = "second")
  ),
  tryCatch(
    yardstick::pr_auc(test_results, truth = Group, .pred_pos, event_level = "second"),
    error = function(e) yardstick::pr_auc(test_results, truth = Group, estimate = .pred_pos, event_level = "second")
  ),
  yardstick::sens(test_results, truth = Group, estimate = .pred_class, event_level = "second"),
  yardstick::spec(test_results, truth = Group, estimate = .pred_class, event_level = "second")
)
print(test_metrics)
