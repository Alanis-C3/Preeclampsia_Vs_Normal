# Predicting k-means clusters (1-vs-rest) with lasso logistic regression

# deps
if (!requireNamespace("tidymodels", quietly = TRUE)) install.packages("tidymodels")
if (!requireNamespace("tidyclust", quietly = TRUE)) install.packages("tidyclust")
if (!requireNamespace("broom", quietly = TRUE)) install.packages("broom")
library(tidymodels); library(tidyclust); library(broom)

set.seed(2025)

# Expect expr_top (genes x samples), pheno, dat, rec from your earlier chunks
stopifnot(exists("expr_top"), exists("pheno"))

# If cluster assignments from k=2 aren't in the environment, compute them
if (!exists("clusters")) {
  dat <- t(expr_top) %>%
    as.data.frame() %>%
    tibble::as_tibble(rownames = "sample") %>%
    dplyr::left_join(pheno, by = "sample")

  rec <- recipe(~ ., data = dat) %>%
    update_role(sample, Group, new_role = "id") %>%
    step_zv(all_predictors()) %>%
    step_normalize(all_predictors())

  k_spec <- k_means(num_clusters = 2) %>% set_engine("stats")
  wf_k2 <- workflow() %>% add_model(k_spec) %>% add_recipe(rec)
  fit_k2 <- fit(wf_k2, dat)
  preds_k2 <- predict(fit_k2, dat)

  clusters <- dat %>%
    dplyr::select(sample, Group) %>%
    dplyr::bind_cols(preds_k2) %>%
    dplyr::rename(cluster = .pred_cluster) %>%
    dplyr::mutate(cluster = as.character(cluster))
}

# Identify the "cluster of interest" as the one that is Preeclampsia-majority; fallback to largest cluster
cluster_map <- clusters %>%
  dplyr::group_by(cluster) %>%
  dplyr::summarise(
    n = dplyr::n(),
    major_group = names(sort(table(Group), decreasing = TRUE))[1],
    .groups = "drop"
  )

pe_like_cluster <- cluster_map %>%
  dplyr::filter(major_group == "Preeclampsia") %>%
  dplyr::slice_max(n, n = 1, with_ties = FALSE) %>%
  dplyr::pull(cluster)

if (length(pe_like_cluster) == 0) {
  pe_like_cluster <- cluster_map %>% dplyr::slice_max(n, n = 1) %>% dplyr::pull(cluster)
}

# Build modeling DF: samples as rows, genes as cols; outcome = PE_like vs Other
X <- t(expr_top)
colnames(X) <- make.unique(unname(gene_lookup[rownames(expr_top)]))
model_df <- X %>%
  as.data.frame() %>%
  tibble::rownames_to_column("sample") %>%
  dplyr::left_join(clusters %>% dplyr::select(sample, Group, cluster), by = "sample") %>%
  dplyr::mutate(
    cluster_bin = factor(ifelse(cluster == pe_like_cluster, "PE_like", "Other"),
                         levels = c("PE_like", "Other"))
  ) %>%
  dplyr::select(-cluster) %>%   # remove raw cluster label to avoid leakage
  dplyr::filter(!is.na(cluster_bin))

# Train/test split stratified on the binary cluster label
split <- initial_split(model_df, prop = 0.8, strata = cluster_bin)
train_df <- training(split)
test_df  <- testing(split)

# CV folds
folds <- vfold_cv(train_df, v = 5, repeats = 2, strata = cluster_bin)

# Recipe: keep IDs only; normalize predictors
rec_clust <- recipe(cluster_bin ~ ., data = train_df) %>%
  update_role(sample, new_role = "id") %>%
  update_role(Group, new_role = "id") %>%  # do not use known Group as predictor
  step_zv(all_predictors()) %>%
  step_normalize(all_predictors())

# L1-penalized logistic regression (lasso), tune penalty
log_spec <- logistic_reg(penalty = tune(), mixture = 1) %>% set_engine("glmnet")
wf <- workflow() %>% add_recipe(rec_clust) %>% add_model(log_spec)

grid <- dials::grid_regular(dials::penalty(), levels = 40)
metrics <- metric_set(roc_auc, pr_auc, accuracy, sens, spec)

set.seed(2025)
tuned <- tune_grid(
  wf, resamples = folds, grid = grid, metrics = metrics,
  control = control_grid(save_pred = TRUE)
)

best <- select_best(tuned, metric = "roc_auc")
final_wf <- finalize_workflow(wf, best)
final_fit <- fit(final_wf, data = train_df)

# Test performance
test_pred_prob <- predict(final_fit, test_df, type = "prob")
test_pred_cls  <- predict(final_fit, test_df, type = "class")
test_out <- bind_cols(test_df %>% dplyr::select(sample, cluster_bin),
                      test_pred_cls, test_pred_prob)

test_metrics <- bind_rows(
  accuracy(test_out, truth = cluster_bin, estimate = .pred_class),
  roc_auc(test_out, truth = cluster_bin, .pred_PE_like),
  pr_auc(test_out, truth = cluster_bin, .pred_PE_like),
  sens(test_out, truth = cluster_bin, estimate = .pred_class),
  spec(test_out, truth = cluster_bin, estimate = .pred_class)
)
print(test_metrics)

conf_mat(test_out, truth = cluster_bin, estimate = .pred_class)

# ROC curve for test set
autoplot(roc_curve(test_out, truth = cluster_bin, .pred_PE_like)) + ggplot2::theme_minimal()

# Top non-zero coefficients at chosen penalty
glmnet_fit <- extract_fit_engine(final_fit)
coef_tbl <- broom::tidy(glmnet_fit, penalty = best$penalty) %>%
  dplyr::filter(term != "(Intercept)", estimate != 0) %>%
  dplyr::arrange(dplyr::desc(abs(estimate)))
head(coef_tbl, 25)
