# Plots for confusion matrix, ROC curve, and AUC (robust to yardstick/tidy changes)


if (!requireNamespace("ggplot2", quietly = TRUE)) install.packages("ggplot2")
if (!requireNamespace("yardstick", quietly = TRUE)) install.packages("yardstick")
if (!requireNamespace("dplyr", quietly = TRUE)) install.packages("dplyr")
library(ggplot2)
library(yardstick)
library(dplyr) 
make_plots <- function(df, truth_col, pred_col, prob_col, label) {
  stopifnot(all(c(truth_col, pred_col, prob_col) %in% names(df)))
  tmp <- df
  tmp$truth <- tmp[[truth_col]]
  tmp$pred  <- tmp[[pred_col]]
  tmp$prob  <- tmp[[prob_col]]

  # Ensure positive class is the second level
  if (truth_col == "Group") {
    tmp$truth <- factor(tmp$truth, levels = c("Control", "Preeclampsia"))
  } else if (truth_col == "cluster_bin") {
    tmp$truth <- factor(tmp$truth, levels = c("Other", "PE_like"))
  }

  # Confusion matrix (row-normalized annotations)
  cm_table <- table(Prediction = tmp$pred, Truth = tmp$truth)
  cm_df <- as.data.frame(cm_table)
  names(cm_df) <- c("Prediction", "Truth", "n")
  totals <- aggregate(n ~ Truth, data = cm_df, sum)
  cm_df <- merge(cm_df, totals, by = "Truth", suffixes = c("", "_total"))
  cm_df$prop <- cm_df$n / cm_df$n_total

  plt_cm <- ggplot(cm_df, aes(x = Prediction, y = Truth, fill = n)) +
    geom_tile(color = "white") +
    geom_text(aes(label = sprintf("%d\n(%.1f%%)", n, 100 * prop)), color = "black", size = 4) +
    scale_fill_gradient(low = "#D7E8FF", high = "#2C6BE8") +
    coord_fixed() +
    labs(title = paste("Confusion Matrix (", label, ")", sep = ""),
         x = "Predicted", y = "Actual", fill = "Count") +
    theme_minimal()

  # ROC and AUC
  roc_tbl <- yardstick::roc_curve(tmp, truth = truth, estimate = prob, event_level = "second")
  auc_val <- yardstick::roc_auc(tmp, truth = truth, estimate = prob, event_level = "second")$.estimate

  plt_roc <- autoplot(roc_tbl) +
    labs(title = paste0("ROC Curve (", label, ")"),
         subtitle = sprintf("ROC AUC = %.3f", auc_val)) +
    theme_minimal()

  plt_auc <- ggplot(data.frame(metric = "ROC AUC", value = auc_val),
                    aes(x = metric, y = value)) +
    geom_col(width = 0.5, fill = "#2C6BE8") +
    geom_hline(yintercept = 0.5, linetype = 2, color = "gray50") +
    geom_text(aes(label = sprintf("%.3f", value)), vjust = -0.4, size = 4) +
    coord_cartesian(ylim = c(0, 1)) +
    labs(title = paste0("AUC (", label, ")"), x = NULL, y = "AUC") +
    theme_minimal()

  list(cm = plt_cm, roc = plt_roc, auc = plt_auc)
}

# Group model plots (requires test_results with Group, .pred_class, .pred_Preeclampsia)
if (exists("test_results") &&
    all(c("Group", ".pred_class", ".pred_Preeclampsia") %in% names(test_results))) {
  test_results$Group <- factor(test_results$Group, levels = c("Control", "Preeclampsia"))
  grp_plots <- make_plots(test_results, "Group", ".pred_class", ".pred_Preeclampsia", "Group")
  print(grp_plots$cm); print(grp_plots$roc); print(grp_plots$auc)
}

